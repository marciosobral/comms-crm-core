# Copy to .env next to docker-compose.yml. Never commit the filled-in file.

# Public domain (DNS A record pointing at the server). The app is served at https://DOMAIN
# and the API at https://DOMAIN/api.
DOMAIN=crm.example.com

POSTGRES_DB=comms_core
POSTGRES_USER=comms_core
# Letters and digits only: it goes inside DATABASE_URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate each with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# First admin, created by: docker compose exec api pnpm db:seed
SEED_ADMIN_EMAIL=admin@example.com
# 12+ characters. The app cannot change this account's password, so keep it here.
SEED_ADMIN_PASSWORD=

# Daily backup of database + uploads into ./backups on the server (local time, America/Sao_Paulo).
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14

# Branding. APP_NAME shows in the page title and breadcrumbs; put logo.png, logo-mark.jpg,
# favicon.png and apple-touch-icon.png in ./branding (not in git) to replace the neutral ones.
APP_NAME=CRM
# PDV and system every sale is tied to (created by the seed).
SALE_DEFAULT_PDV=PDV PADRÃO
SALE_DEFAULT_SYSTEM=SISTEMA PADRÃO
