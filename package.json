{
  "name": "comms-crm-core",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --fix --unsafe .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @comms-crm-core/api db:generate",
    "db:migrate": "pnpm --filter @comms-crm-core/api db:migrate",
    "db:seed": "pnpm --filter @comms-crm-core/api db:seed",
    "db:push": "pnpm --filter @comms-crm-core/api db:push",
    "db:studio": "pnpm --filter @comms-crm-core/api db:studio",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "2.9.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "proxy-addr": "2.0.8",
      "hono": "4.12.25",
      "mysql2": "3.22.0",
      "source-map-js": "1.2.2",
      "browserslist@<4.28.7": "4.28.7",
      "fast-uri@<3.1.7": "3.1.7",
      "js-yaml@<4.3.2": "4.3.2",
      "lodash@<4.18.0": "4.18.1",
      "brace-expansion@<2": "1.1.20",
      "brace-expansion@>=5 <6": "5.0.11"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
