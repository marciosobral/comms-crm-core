    "@nestjs/schematics": "11.0.10",
    "@types/express": "5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "22.19.17",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "7.7.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
