    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:normalize-documents": "tsx prisma/normalize-documents.ts"
  },
  "dependencies": {
    "@comms-core/config": "workspace:*",
    "@comms-core/validation": "workspace:*",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "argon2": "^0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.5.0",
    "helmet": "8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "^3.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
