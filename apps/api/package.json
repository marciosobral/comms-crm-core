{
  "name": "@comms-core/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "lint": "biome check .",
    "test": "vitest run",
    "clean": "rm -rf dist",
