DATABASE_URL=postgresql://user:password@localhost:5432/comms_core
PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
# Reverse proxies in front of the API (1 behind Caddy)
TRUST_PROXY=0
# Initial admin created by `pnpm db:seed` (password required when NODE_ENV=production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
