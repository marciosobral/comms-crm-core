# Client identity (no secrets). Lives in the private crm-clients repo as clients/<client>/client.env.
# Secrets (POSTGRES_PASSWORD, JWT_SECRET, JWT_REFRESH_SECRET, SEED_ADMIN_PASSWORD) are generated
# on the server by client-add.sh into /opt/crm/instances/<client>/.env.

# Lowercase letters, digits and dashes; names the compose project and the proxy aliases.
CLIENT=example
# DNS A record must point at the server before client-add.sh.
DOMAIN=crm.example.com
# Name in page titles and breadcrumbs. Logos come from branding/ next to this file.
APP_NAME=CRM
# PDV and system every sale is tied to; both must be listed in seed.json.
SALE_DEFAULT_PDV=PDV PADRÃO
SALE_DEFAULT_SYSTEM=SISTEMA PADRÃO
# System admin (reference 9999) created by the seed.
SEED_ADMIN_EMAIL=admin@example.com
# Daily backup of database + uploads (local time, America/Sao_Paulo).
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Public key that encrypts every backup. Generate with `age-keygen -o backup-key.txt` on your machine,
# keep the private key off the server and paste the public key (age1...) here. Required.
BACKUP_AGE_RECIPIENT=age1...
